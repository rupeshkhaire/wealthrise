    <!-- ============ GLOSSARY ============ -->
    <section id="glossary">
      <h2 class="section-title">Jargon Buster Glossary</h2>
      <div class="glossary-grid">
        <div class="g-item"><span class="g-term">Golden Record</span><p class="g-def">The final, verified, 100% correct version of the event's facts that the bank relies on.</p></div>
        <div class="g-item"><span class="g-term">Entitlement</span><p class="g-def">The exact amount of cash or shares you are owed (Position x Rate).</p></div>
        <div class="g-item"><span class="g-term">Reconciliation</span><p class="g-def">Double-checking the receipts to make sure the money expected matches the money received.</p></div>
        <div class="g-item"><span class="g-term">Manufactured Payment</span><p class="g-def">A fake dividend paid out of someone else's pocket to replace your real dividend, because your shares were loaned out.</p></div>
        <div class="g-item"><span class="g-term">Proration</span><p class="g-def">When too many people say "Yes" to a deal, the company reduces everyone's slice proportionally to keep it fair.</p></div>
        <div class="g-item"><span class="g-term">STP (Straight-Through Processing)</span><p class="g-def">When an event (like a dividend) is so simple that computers handle it 100% automatically without a human touching it.</p></div>
      </div>
    </section>

