  </main>
</div>

<script>
  const html = document.documentElement;
  const themeToggle = document.getElementById('themeToggle');
  function applyThemeLabel(){
    const dark = html.getAttribute('data-theme') === 'dark';
    themeToggle.innerHTML = dark ? '☀️ &nbsp;Switch to light mode' : '🌙 &nbsp;Switch to dark mode';
  }
  themeToggle.addEventListener('click', () => {
    const cur = html.getAttribute('data-theme');
    html.setAttribute('data-theme', cur === 'dark' ? 'light' : 'dark');
    applyThemeLabel();
  });
  if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
    html.setAttribute('data-theme', 'dark');
  }
  applyThemeLabel();

  const sidebar = document.getElementById('sidebar');
  const navToggle = document.getElementById('navToggle');
  navToggle.addEventListener('click', () => sidebar.classList.toggle('open'));
  document.querySelectorAll('.toc a').forEach(a => a.addEventListener('click', () => sidebar.classList.remove('open')));

  const tocLinks = Array.from(document.querySelectorAll('.toc a'));
  const targets = tocLinks.map(a => document.querySelector(a.getAttribute('href'))).filter(Boolean);
  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      const id = '#' + entry.target.id;
      const link = tocLinks.find(a => a.getAttribute('href') === id);
      if (!link) return;
      if (entry.isIntersecting) {
        tocLinks.forEach(a => a.classList.remove('active'));
        link.classList.add('active');
      }
    });
  }, { rootMargin: '-15% 0px -70% 0px' });
  targets.forEach(t => io.observe(t));

  const searchBox = document.getElementById('searchBox');
  const searchStatus = document.getElementById('searchStatus');
  const allCards = Array.from(document.querySelectorAll('.ca-card'));
  const allGlossary = Array.from(document.querySelectorAll('.g-item'));
  searchBox.addEventListener('input', () => {
    const q = searchBox.value.trim().toLowerCase();
    let shown = 0;
    allCards.forEach(card => {
      const match = !q || card.innerText.toLowerCase().includes(q);
      card.style.display = match ? '' : 'none';
      if (match) shown++;
      const link = tocLinks.find(a => a.getAttribute('href') === '#' + card.id);
      if (link) link.dataset.hidden = match ? '0' : '1';
    });
    allGlossary.forEach(item => {
      const match = !q || item.innerText.toLowerCase().includes(q);
      item.style.display = match ? '' : 'none';
    });
    searchStatus.textContent = q ? (shown + ' instrument' + (shown===1?'':'s') + ' match') : '';
  });
</script>
</body>
</html>
